 #include <android-base/strings.h>
 
-#if defined(__ANDROID__)
+#if defined(__linux__)  // Android, or Linux with build/platform
 #include <libminijail.h>
 #include <log/log_properties.h>
 #include <scoped_minijail.h>
@@ -59,7 +59,7 @@
 #include "daemon/transport_daemon.h"
 #include "daemon/watchdog.h"
 
-#if defined(__ANDROID__)
+#if defined(__linux__)  // Android, or Linux with build/platform
 static const char* root_seclabel = nullptr;
 static const char* tim_seclabel = nullptr;
 
@@ -219,7 +219,7 @@ int adbd_main() {
     // descriptor will always be open.
     adbd_cloexec_auth_socket();
 
-#if defined(__ANDROID__)
+#if defined(__linux__)  // Android, or Linux with build/platform
     bool device_unlocked = android::base::GetProperty("ro.boot.verifiedbootstate", "") == "orange";
     if (device_unlocked || __android_log_is_debuggable()) {
 #if defined(__ANDROID_RECOVERY__)
@@ -245,7 +245,7 @@ int adbd_main() {
           " unchanged.\n");
     }
 
-#if defined(__ANDROID__)
+#if defined(__linux__)  // Android, or Linux with build/platform
     drop_privileges();
 #endif
 
@@ -260,7 +260,7 @@ int adbd_main() {
 
     bool is_usb = false;
 
-#if defined(__ANDROID__)
+#if defined(__linux__)  // Android, or Linux with build/platform
     if (access(USB_FFS_ADB_EP0, F_OK) == 0) {
         // Listen on USB.
         usb_init();
@@ -340,7 +340,7 @@ int main(int argc, char** argv) {
         }
 
         switch (c) {
-#if defined(__ANDROID__)
+#if defined(__linux__)  // Android, or Linux with build/platform
             case 's':
                 root_seclabel = optarg;
                 break;
